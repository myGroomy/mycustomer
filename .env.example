# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# Upstash Redis (opsional — cache server-side sheet.
# Jika dikosongkan, app membaca langsung ke Google Sheets tanpa cache.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TTL cache dalam detik (opsional, default 30)
SHEET_CACHE_TTL_SECONDS=30

# Must be at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=
LAUNCHER_SSO_SHARED_SECRET=

# Optional retention defaults
NEXT_PUBLIC_DEFAULT_CHURN_ACTIVE_DAYS=30
NEXT_PUBLIC_DEFAULT_CHURN_AT_RISK_DAYS=60
